Section 2: DFA (Finite State Automata) Simulator
# DFA Simulator

transitions = {
    'q0': {'a': 'q1', 'b': 'q0'},
    'q1': {'a': 'q1', 'b': 'q2'},
    'q2': {'a': 'q1', 'b': 'q0'}
}

start_state = 'q0'
final_states = ['q2']

while True:
    string = input("\nEnter input string: ")

    current_state = start_state
    path = current_state

    valid = True

    for ch in string:
        if ch not in ['a', 'b']:
            valid = False
            break

        current_state = transitions[current_state][ch]
        path += " -> " + current_state

    if not valid:
        print("Invalid Input")
    else:
        print("Transition Path:", path)

        if current_state in final_states:
            print("Accepted")
        else:
            print("Rejected")

    choice = input("Test another string? (yes/no): ")
    if choice.lower() != "yes":
        break
